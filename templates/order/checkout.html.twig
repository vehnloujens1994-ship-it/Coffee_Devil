{% extends 'base.html.twig' %}

{% block title %}Checkout — Dizon Coffee Roasters{% endblock %}

{% block body %}
<div class="page">
    <h1>Checkout</h1>

    {% for message in app.flashes('error') %}
        <div class="alert alert--error">{{ message }}</div>
    {% endfor %}

    <div class="card">
        <table>
            <thead>
                <tr><th>Item</th><th>Quantity</th><th class="num">Line Total</th></tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr>
                        <td>{{ item.name }}</td>
                        <td>{{ item.quantity }}</td>
                        <td class="num">PHP {{ item.lineTotal|number_format(2) }}</td>
                    </tr>
                {% endfor %}
                <tr class="cart-total-row">
                    <td colspan="2">Total</td>
                    <td class="num">PHP {{ total|number_format(2) }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <br>
    <form method="post" action="{{ path('app_place_order') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
        <div class="card">
            <h3>Payment method</h3>
            <div class="form-group">
                <label><input type="radio" name="payment_method" value="cod" checked> Cash on Delivery</label>
            </div>
            <div class="form-group">
                <label><input type="radio" name="payment_method" value="gcash"> GCash</label>
            </div>
            <div class="form-group" id="gcashBox" style="display:none;">
                <label for="reference_code">GCash reference number</label>
                <input type="text" id="reference_code" name="reference_code" maxlength="50"
                       pattern="[0-9\-]+" placeholder="e.g. 1234-567-890">
            </div>
        </div>
        <br>
        <div style="text-align:right;">
            <a href="{{ path('app_cart') }}" class="btn btn--outline-dark">Back to Bag</a>
            <button type="submit" class="btn btn--gold">Place Order</button>
        </div>
    </form>
</div>

<script>
    const box = document.getElementById('gcashBox');
    const ref = document.getElementById('reference_code');
    document.querySelectorAll('input[name="payment_method"]').forEach(function (r) {
        r.addEventListener('change', function () {
            const gcash = document.querySelector('input[name="payment_method"]:checked').value === 'gcash';
            box.style.display = gcash ? 'block' : 'none';
            ref.required = gcash;
        });
    });
</script>
{% endblock %}